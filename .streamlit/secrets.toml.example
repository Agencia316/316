# Copie este arquivo para .streamlit/secrets.toml e preencha com seus valores.
# No Streamlit Cloud, configure estas variáveis em:
# App Settings > Secrets

FB_ACCESS_TOKEN = "seu_token_aqui"

# Painel jurídico (painel_juridico.py) — API do Robô Jurídico rodando no Brasil
JURIDICO_API_URL = "https://api.seudominio.com.br"
JURIDICO_API_KEY = "chave_do_cliente_gerada_em_/admin"
